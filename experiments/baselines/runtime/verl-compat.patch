+def _padding_aware_group_partitions(
+    seq_len_effective: list[int],
+    max_token_len: int,
+    force_group_size: int,
+) -> list[list[int]]:
+    """Pack atomic sample groups under the actual padded-token budget.
+
+    When remove-padding is disabled, a micro-batch containing ``n`` samples is
+    materialized as a dense tensor with ``n * max(sequence_lengths)`` token
+    slots.  A partition that respects the sum of valid tokens can therefore
+    still be much larger than ``max_token_len`` after padding.
+
+    This helper applies deterministic first-fit decreasing to consecutive
+    ``force_group_size`` groups.  It returns group indices rather than sample
+    indices so callers can subsequently split partitions without violating the
+    grouping constraint.
+    """
+    assert force_group_size > 0, f"force_group_size must be positive, got {force_group_size}"
+    assert len(seq_len_effective) % force_group_size == 0
+
+    num_groups = len(seq_len_effective) // force_group_size
+    group_max_seqlens = [
+        max(seq_len_effective[offset : offset + force_group_size])
+        for offset in range(0, len(seq_len_effective), force_group_size)
+    ]
+    group_workloads = [
+        sum(seq_len_effective[offset : offset + force_group_size])
+        for offset in range(0, len(seq_len_effective), force_group_size)
+    ]
+
+    for group_idx, group_max_seqlen in enumerate(group_max_seqlens):
+        padded_tokens = force_group_size * group_max_seqlen
+        assert padded_tokens <= max_token_len, (
+            f"Atomic group {group_idx} needs {padded_tokens} padded tokens, exceeding "
+            f"max_token_len={max_token_len}. Increase the token budget or reduce force_group_size."
+        )
+
+    # Longest groups first makes each bin's eventual padded width known when it
+    # is opened.  The workload tie-breaker and group index make the result stable.
+    sorted_groups = sorted(
+        range(num_groups),
+        key=lambda idx: (-group_max_seqlens[idx], -group_workloads[idx], idx),
+    )
+    partitions: list[list[int]] = []
+    partition_max_seqlens: list[int] = []
+
+    for group_idx in sorted_groups:
+        group_max_seqlen = group_max_seqlens[group_idx]
+        for partition_idx, partition in enumerate(partitions):
+            padded_width = max(partition_max_seqlens[partition_idx], group_max_seqlen)
+            padded_tokens = (len(partition) + 1) * force_group_size * padded_width
+            if padded_tokens <= max_token_len:
+                partition.append(group_idx)
+                partition_max_seqlens[partition_idx] = padded_width
+                break
+        else:
+            partitions.append([group_idx])
+            partition_max_seqlens.append(group_max_seqlen)
+
+    return partitions
+
+
+def _split_group_partitions(
+    partitions: list[list[int]],
+    group_workloads: list[int],
+    target_num_partitions: int,
+) -> list[list[int]]:
+    """Split existing group partitions until an exact target count is reached.
+
+    Every output is a subset of an input partition, so a padded-token bound that
+    held for the inputs also holds for the outputs.  This is used after the DP
+    ranks synchronize their required micro-batch count.
+    """
+    assert len(partitions) <= target_num_partitions <= sum(len(partition) for partition in partitions)
+    partitions = [list(partition) for partition in partitions]
+
+    while len(partitions) < target_num_partitions:
+        splittable_idx = max(
+            (idx for idx, partition in enumerate(partitions) if len(partition) > 1),
+            key=lambda idx: (
+                sum(group_workloads[group_idx] for group_idx in partitions[idx]),
+                len(partitions[idx]),
+                -idx,
+            ),
+        )
+        partition = partitions.pop(splittable_idx)
+        ordered_groups = sorted(partition, key=lambda idx: (-group_workloads[idx], idx))
+
+        # Seed both sides to guarantee that the split is non-empty, then greedily
+        # balance the remaining groups by valid-token workload.
+        split = [[ordered_groups[0]], [ordered_groups[1]]]
+        split_workloads = [group_workloads[ordered_groups[0]], group_workloads[ordered_groups[1]]]
+        for group_idx in ordered_groups[2:]:
+            side = min(range(2), key=lambda idx: (split_workloads[idx], idx))
+            split[side].append(group_idx)
+            split_workloads[side] += group_workloads[group_idx]
+
+        partitions[splittable_idx:splittable_idx] = split
+
+    return partitions
+
